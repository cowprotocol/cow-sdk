{
  "name": "@cowprotocol/sdk-trading-solana",
  "version": "0.2.0",
  "description": "CowProtocol Solana trading: Jupiter-sourced quotes and on-chain CreateOrder posting against the Solana settlement program",
  "repository": {
    "type": "git",
    "url": "https://github.com/cowprotocol/cow-sdk.git",
    "directory": "packages/sdk-trading-solana"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:badges": "istanbul-badges-readme --exitCode=1",
    "test:coverage:html": "jest --silent=false --coverage --coverageReporters html",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@cow-sdk/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.31",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "ts-jest": "^29.0.0"
  },
  "dependencies": {
    "@cowprotocol/sdk-config": "workspace:*",
    "@cowprotocol/sdk-order-book": "workspace:*",
    "@cowprotocol/sdk-trading": "workspace:*",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4"
  }
}
